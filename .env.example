# sdlc-integrations MCP server configuration (template, no real values).
# Copy to .env and fill in values, or export these in your shell.
# Keep .env out of git (it must be git-ignored). Never commit real tokens.
# Empty values count as unset.

# Jira Cloud (needed for jira_* tools)
# Format example: https://your-site.atlassian.net
JIRA_BASE_URL=
# Atlassian account email used with the API token
JIRA_EMAIL=
# Jira Cloud API token, created in your Atlassian account security settings
JIRA_API_TOKEN=

# Confluence Cloud (needed for confluence_* tools)
# Format example: https://your-site.atlassian.net/wiki (required; not derived from JIRA_BASE_URL)
CONFLUENCE_BASE_URL=
# Optional: defaults to JIRA_EMAIL when empty
CONFLUENCE_EMAIL=
# Optional: defaults to JIRA_API_TOKEN when empty
CONFLUENCE_API_TOKEN=

# GitHub (needed for github_* tools)
# Fine-grained personal access token, scoped to the repositories you need
GITHUB_TOKEN=
# Optional: defaults to https://api.github.com. Set for GitHub Enterprise Server (https only).
GITHUB_API_URL=
