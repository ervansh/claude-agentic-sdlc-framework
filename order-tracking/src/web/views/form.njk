{% extends "layout.njk" %}
{% block title %}{% if summaryMessage %}Error: {% endif %}Track your order - Order Tracking{% endblock %}
{% block content %}
<h1>Track your order</h1>

{% if summaryMessage %}
<div id="error-summary" role="alert" tabindex="-1" data-error-summary>
<h2>There is a problem</h2>
<p>{{ summaryMessage }}</p>
</div>
{% endif %}

<form method="post" action="/track" novalidate>
<div>
<label for="orderNumber">Order number</label>
<p id="orderNumber-hint">For example, ORD1234567.</p>
{% if fieldMessage %}
<p id="orderNumber-error"><strong>Error:</strong> {{ fieldMessage }}</p>
{% endif %}
<input type="text" id="orderNumber" name="orderNumber" value="{{ orderNumber }}" autocomplete="off" maxlength="40"
 aria-describedby="orderNumber-hint{% if fieldMessage %} orderNumber-error{% endif %}"{% if fieldMessage %} aria-invalid="true"{% endif %}>
</div>
<div>
<label for="lastName">Last name (optional)</label>
<input type="text" id="lastName" name="lastName" value="" autocomplete="off" maxlength="100">
</div>
<button type="submit">Track order</button>
</form>
{% endblock %}
